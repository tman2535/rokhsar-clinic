# Copy to .env and edit. Lines starting with # are ignored.
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# For a real domain, e.g.:
# DJANGO_ALLOWED_HOSTS=rokhsarclinic.ir,www.rokhsarclinic.ir
# DJANGO_CSRF_TRUSTED_ORIGINS=https://rokhsarclinic.ir,https://www.rokhsarclinic.ir

# Public address of the site — used for links in Telegram messages and the bot webhook.
SITE_BASE_URL=http://127.0.0.1:8000

# 1 = show "sample content" note in the footer. Set 0 once real content is in.
DEMO_CONTENT=1

# Serve uploaded photos from Django when there is no nginx in front (small servers).
SERVE_MEDIA=0

# PostgreSQL (optional; SQLite is used when DB_ENGINE is empty)
# DB_ENGINE=postgres
# DB_NAME=rokhsar
# DB_USER=rokhsar
# DB_PASSWORD=secret
# DB_HOST=localhost
# DB_PORT=5432

# Email channel (optional)
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=clinic@example.com
# EMAIL_HOST_PASSWORD=secret
# DEFAULT_FROM_EMAIL=clinic@example.com
