# systemd unit — keeps the site running and restarts it after reboot.
# 1) Replace /srv/rokhsar with your project path and www-data with your user if different.
# 2) sudo cp deploy/rokhsar.service /etc/systemd/system/
# 3) sudo systemctl daemon-reload && sudo systemctl enable --now rokhsar
[Unit]
Description=Rokhsar clinic (gunicorn)
After=network.target

[Service]
User=www-data
Group=www-data
WorkingDirectory=/srv/rokhsar
Environment=PYTHONUTF8=1
ExecStart=/srv/rokhsar/.venv/bin/gunicorn config.wsgi --bind 127.0.0.1:8001 --workers 3 --timeout 60
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
